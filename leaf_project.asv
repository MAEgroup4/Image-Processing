
clear; clc; close all;

fprintf('Initializing Leaf Structural Array Database...\n\n');

leaf_database = struct('ID', {}, ...
                       'CommonName', {}, ...
                       'ScientificName', {}, ...
                       'LeafType', {}, ...
                       'VenationPattern', {}, ...
                       'MarginType', {}, ...
                       'ApexShape', {}, ...
                       'OriginalImage', {}, ...
                       'GrayImage', {}, ...
                       'BinaryMask', {}, ...
                       'EdgeOutline', {});

fig1=figure;
imgD = imread('cassava_raw.jpeg');
grayD = rgb2gray(imgD);

hsvD = rgb2hsv(imgD);
maskD = (hsvD(:,:,1) > 0.16 & hsvD(:,:,1) < 0.45) & (hsvD(:,:,2) > 0.20);
maskD = imfill(bwareaopen(maskD, 120), 'holes');
edgeD = edge(grayD, 'Canny', [0.04 0.12]);
imshow(imgD);
imshow(grayD);
imshow(maskD);
imshow(edgeD);

leaf_database(1).ID = 1;
leaf_database(1).CommonName = 'Cassava (Manioc)';
leaf_database(1).ScientificName = 'Manihot esculenta';
leaf_database(1).LeafType = 'Palmately Compound / Lobed';
leaf_database(1).VenationPattern = 'Palmate';
leaf_database(1).MarginType = 'Entire';
leaf_database(1).ApexShape = 'Acuminate';
leaf_database(1).OriginalImage = imgD;
leaf_database(1).GrayImage = grayD;
leaf_database(1).BinaryMask = maskD;
leaf_database(1).EdgeOutline = edgeD; 
%% 

fig2=figure;
imgH = imread('maize_raw.jpeg');
grayH = rgb2gray(imgH);

hsvH = rgb2hsv(imgH);
maskH = (hsvH(:,:,1) > 0.16 & hsvH(:,:,1) < 0.42) & (hsvH(:,:,2) > 0.22);
maskH = imfill(bwareaopen(maskH, 120), 'holes');
edgeH = edge(grayH, 'Canny', [0.04 0.14]);
imshow(imgH);
imshow(grayH);
imshow(maskH);
imshow(edgeH);

leaf_database(2).ID = 2;
leaf_database(2).CommonName = 'Maize (Corn)';
leaf_database(2).ScientificName = 'Zea mays';
leaf_database(2).LeafType = 'Simple (Linear / Strap-like)';
leaf_database(2).VenationPattern = 'Parallel';
leaf_database(2).MarginType = 'Entire / Slightly Undulate';
leaf_database(2).ApexShape = 'Acuminate';
leaf_database(2).OriginalImage = imgH;
leaf_database(2).GrayImage = grayH;
leaf_database(2).BinaryMask = maskH;
leaf_database(2).EdgeOutline = edgeH;
%% 

imgC = imread('candlebush_raw.jpeg');
grayC = rgb2gray(imgC);

hsvC = rgb2hsv(imgC);
maskC = (hsvC(:,:,1) > 0.18 & hsvC(:,:,1) < 0.42) & (hsvC(:,:,2) > 0.25);
maskC = imfill(bwareaopen(maskC, 80), 'holes');
edgeC = edge(grayC, 'Sobel');
imshow(imgC);
imshow(grayC);
imshow(maskC);
imshow(edgeC);

leaf_database(3).ID = 3;
leaf_database(3).CommonName = 'candlebush';
leaf_database(3).ScientificName = 'Senna siamea / Cassia siamea';
leaf_database(3).LeafType = 'Pinnately Compound';
leaf_database(3).VenationPattern = 'Pinnate';
leaf_database(3).MarginType = 'Entire';
leaf_database(3).ApexShape = 'Obtuse to Mucronate';
leaf_database(3).OriginalImage = imgC;
leaf_database(3).GrayImage = grayC;
