fig3=figure;
imgN = imread('yam_raw.jpeg');
grayN = rgb2gray(imgN);

hsvN = rgb2hsv(imgN);
maskN = (hsvN(:,:,1) > 0.15 & hsvN(:,:,1) < 0.42) & (hsvN(:,:,2) > 0.20);
maskN = imfill(bwareaopen(maskN, 150), 'holes');
edgeN = edge(grayN, 'Canny', [0.05 0.15]);
imshow(imgN);
imshow(grayN);
imshow(maskN);
imshow(edgeN);

