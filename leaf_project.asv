%% 
imgG = imread('fene.jpeg');
grayG = rgb2gray(imgG);

% Image Processing Onramp techniques (Green channel thresholding & Canny edge)
hsvG = rgb2hsv(imgG);
maskG = (hsvG(:,:,1) > 0.15 & hsvG(:,:,1) < 0.42) & (hsvG(:,:,2) > 0.20);
maskG = imfill(bwareaopen(maskG, 100), 'holes');
edgeG = edge(grayG, 'Canny', [0.05 0.15]);

leaf_database(7).ID = 7;
leaf_database(7).CommonName = 'Jackfruit (Fene)';
leaf_database(7).ScientificName = 'Artocarpus heterophyllus';
leaf_database(7).LeafType = 'Simple';
leaf_database(7).VenationPattern = 'Pinnate';
leaf_database(7).MarginType = 'Entire';
leaf_database(7).ApexShape = 'Obtuse to Subacute';
leaf_database(7).OriginalImage = imgG;
leaf_database(7).GrayImage = grayG;
leaf_database(7).BinaryMask = maskG;
leaf_database(7).EdgeOutline = edgeG;
